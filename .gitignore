# Ignore Heavy Model Weights
*.pt
models/**/*.pt
models/**/*.weights
models/**/*.engine
models/**/*.onnx
models/**/*.bin


# Ignore legacy configs if not actively used
yolo-coco/
*.cfg

# Ignore Local Virtual Environments (CRITICAL)
venv/
.venv/
env/
.conda/
miniconda/

# Ignore Python Caches and IDE files
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/

# Ignore OS metadata
.DS_Store
Thumbs.db
